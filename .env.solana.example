# Export these in the shell for go run ./cmd/indexer, or copy to .env for Compose live.
CHAIN_PROTOCOL=solana
CHAIN=solana-mainnet
# Full 32-byte genesis hash returned by getGenesisHash (not a shortened CAIP ID).
CHAIN_ID=REPLACE_WITH_FULL_GENESIS_HASH
TOKEN_ADDRESS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# Token accounts, not wallet owner addresses. Base58 is case-sensitive.
WATCH_ADDRESSES=REPLACE_WITH_REGISTERED_USDC_TOKEN_ACCOUNTS
# Anchor is an independently verified produced block; start is anchor slot + 1.
ANCHOR_NUMBER=REPLACE_WITH_PRODUCED_SLOT
ANCHOR_HASH=REPLACE_WITH_BLOCKHASH
START_BLOCK=REPLACE_WITH_ANCHOR_SLOT_PLUS_ONE
BATCH_SIZE=5
REPLAY_BLOCKS=0
POLL_INTERVAL=3s
RPC_PROVIDERS=[{"name":"primary","url":"https://REPLACE"},{"name":"backup","url":"https://REPLACE"}]
DATABASE_URL=postgres://settlement:settlement-local@127.0.0.1:55437/settlement?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
